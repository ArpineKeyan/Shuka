# Copy this file to .env for local work. Never commit .env.
PORT=3000
# Any long random text. Signs the login cookie.
SESSION_SECRET=change-me-to-something-long-and-random
# Leave empty locally: a file in server/data/ is used.
# On Render: libsql://shuka-<you>.turso.io and the Turso token.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Leave empty locally: photos are saved in server/data/uploads/.
# On Render: copy these from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
